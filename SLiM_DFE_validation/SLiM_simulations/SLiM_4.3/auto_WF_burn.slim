/*
command line usage example:
slim -d Qfactor=10 -d L=5e5 -d BURNIN=20 -d REP=1 -d ID=1 -d SEED=365 auto_WF_burn.slim
*/

// set up a simple WF burnin for later polyploid formation
// see the nonWF scripts for more details on parameters, model choices and assumptions, etc.

initialize() {
	if (exists("Qfactor")){
      defineConstant("Q", Qfactor);
    } else{
      defineConstant("Q", 10);
    }	
	
	// constants for file management
	if (exists("REP")){
      defineConstant("rep", REP);
    } else{
      defineConstant("rep", 1);
    }	
   if (exists("ID")){
      defineConstant("id", ID);
    } else{
      defineConstant("id", 1);
    }		
	
	// set the seed, pulling in the rep and id to differentiate among runs
	if (exists("SEED")){
		setSeed(asInteger(SEED + id * rep + 123));
	} else{
		setSeed(asInteger(42 + id * rep + 123));
	}
	
	initializeMutationRate((2.5/3.5)*7e-9*Q); // from stdpopsim catalog for Arabidopsis thaliana
	
	// m1 mutation type: gamma DFE, additive dominance from Huber 2018
	initializeMutationType("m1", 0.5, "g", -0.00021600000000000002 * Q, 0.27);
	
	// g1 genomic element type: uses m1 for all mutations
	// we will overlay neutral mutations later with msprime
	initializeGenomicElementType("g1", m1, 1.0);
	
	// define the genome length
	if (exists("L")){
      defineConstant("g_size", L - 1);
    } else{
      defineConstant("g_size", 5e3 - 1);
    }
		
	// SRG: Switch the commenting below for a genome with genic and intergenic regions or exons and introns (depending on your interpretation)
	initializeGenomicElement(g1, 0, g_size);
	//defineConstant("L0", 200e3); // between genes
	//defineConstant("L1", 1e3); // gene length
	//for (start in seq(from=L0, to=g_size-(L0+L1), by=(L0+L1)))
	//	initializeGenomicElement(g1, start, (start+L1)-1);
	
	
	initializeRecombinationRate((1-(1-2*3.676138452842427e-08)^Q)/2);
	
	m1.convertToSubstitution = T;
	
	// define burnin period (in terms of N generations
   if (exists("BURNIN")){
      defineConstant("burnin", BURNIN);
    } else{
      defineConstant("burnin", 20.0);
    }	
	
	// use tree sequence recording to check for coalesence
	initializeTreeSeq();
	
	// stop the simulation early if the output file already exists
	if (fileExists("trees/burnin/auto_burnin_Q_"+Q+"_REP_"+rep+"_ID_"+id+".trees")){
		stop("File trees/burnin/auto_burnin_Q_"+Q+"_REP_"+rep+"_ID_"+id+".trees already exists");	
	}
}

// create a population 
1 early() {
	sim.addSubpop("p1", asInteger(round(161744.0/Q)) );
}

// monitor fitness
1:(asInteger(round(burnin*161744.0/Q))) early() {
	if(community.tick % 100000 == 0) {
	    print(community.tick);
		print(mean(p1.cachedFitness(NULL)));
	}
}

// so, instead, we stop after BURNIN*N generations
asInteger(round(burnin*161744.0/Q)) late() {
	sim.treeSeqOutput("trees/burnin/auto_burnin_Q_"+Q+"_REP_"+rep+"_ID_"+id+".trees");
}


