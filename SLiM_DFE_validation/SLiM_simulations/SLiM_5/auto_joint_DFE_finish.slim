/*
command line usage example:
slim -d Qfactor=10 -d W=0.925 -d RHO=0 -d L=5e5 -d BURNIN=20 -d REP=1 -d ID=1 -d SEED=365 -d M_RATE=2.0 -d NU1=0.3 -d NU2=0.7 -d TET_TIME=0.3 -d NU_DIP=0.8 -d DIP_TIME=0.15 auto_joint_DFE_finish.slim
*/

//Samuel R. Gibbon and Justin L. Conover, 22 August 2026: autotetraploidy with diploids and a joint DFE mixture model. The model loads a tree sequence from a diploid WF burn-in.
//William W. Booker, 10 January 2024: autotetraploidy
//Based on a concept by Yaniv Brandvain and Peter Ralph

// Written for compatibility with SLiM 5

/*  
	Details on autotetraploidy:
	
	This is a nonWF model of an autotetraploid with bivalent pairing and tetrasomic inheritance with `soft` selection (i.e., fecundity selection as in a WF model)
   	To do this, we have to:
	
	(a) give each individual *four* genomes
	(b) let crossing-over happen between any of the possible pairings
	(c) compute fitness with all four genomes
	
	(a) Four genomes: the "real" individuals are in p3. Each individual has their other two genomes stashed
	away in an individual in p2; the individuals in p2 don't do anything on their own. To identify them,
	each individual in p3 has a "tag" that records the index of their pair in p2, so that
	    p2.individuals[ind.tag].genomes
	gets you the other two genomes for individual "ind" in p2. (To create these associations, we give each
	individual a unique label, stored in their tagF property, and then index them each generation to set the tag) 
	
	(b) For crossing-over, we pick random orderings of each of the mates' four genomes,
    	then do crossing-over between pairs. Importantly, recombination here is still bivalent, but with tetrasomic
    	inheritance. Many autopolyploids form quadrivalents or can have some disomic inheritance. Quadrivalents
    	would require some complicated scripting, but bivalents can be modeled as described below.
	
	(c) Every new mutation has a property, "h", the dominance coefficient, that is a vector of length 5, 
    	and "s" which is the selection coefficient. For simplicity, we only model additive selection (i.e., h = [0, 0.25, 0.5, 0.75, 1]). Fitness is calculated by taking the count of the number of mutations [0-4],
    	using that as the index of the h vector, and multiplying that by s. In this model fitness is multiplicative.
    	Then, fitness is stored for each 'real' individual in p3 and used to weight reproductive success in the following generation. 

*/

/*
	Joint DFE:
		The joint DFE is modeled as a mixture model of a perfectly correlated marginal lognormal distribution and a 2D lognormal with the same marginal parameters and (most often) zero correlation. 
		
		To implement such a model, we introduce two mutation types: m1 and m2. 
		The m1 mutations correspond to the non-perfectly correlated mutations and have both an s and s2 value set for them. The s value is the selection coefficent in the diploid population and the s2 value is the selection coefficient in the autotetraploid population.
		The m2 mutations correspond to the perfectly correlated mutations and only have a single s value which is the selection coefficient for both populations.
		
		We base our lognormal DFE on the gamma DFE inferred for additive mutations by Huber et al. 2018 (see stdpopsim catalog). To get a similarly shaped distribution, we set mu = 1.69155136 and sigma = 2.37871223 in terms of gamma = 2Ns by minimizing the Jensen-Shannon divergence for the discretized gamma DFE and discretized lognormal DFE.
		
	Demography: 
		Bottlegrowth for the autotetraploids (roughly based on parameters from Arnold et al. 2015 for A. arenosa) and a single size change (post-WGD) for the diploids. Migration also occurs from the diploid population to the autotetraploid population.
		simple size change for the diploids
		
	Mutation and recombination rates: 
		mu = 7e-9
		We assume that the ratio of synonymous to nonsynonymous mutations is 1:2.5 (although Huber et al. 2018 which uses 1:2.31 may be better). Since tree sequence recording is turned on, we overlay neutral mutations later with msprime.
		r = 3.676138452842427e-08
		Both are from stdpopsim catalog for Arabidopsis thaliana. 
		Note that the recombination rate we use here is *not* adjusted for selfing as it is in the stdpopsim catalog because we want to model A. arenosa.
		
	Effective population size: 
		We assume a diploid ancestral effective population size of 161744 as inferred by Huber et al. 2018 for a three epoch size history. 
*/

/*
	The script will raise a handful of errors (which can be ignored). 
	First, since we load a tree sequence from a WF model into this nonWF model, we will get an error (but this is done intentionally and does not introduce any bugs as far as I (SRG) have checked). 
	Second, since we simulate mutations which are nominally neutral to SLiM and have tree sequence recording turned on, we get an error. But, the mutations have fitness consequences set in s or s2, just not stored in the selection coefficient property of the mutations.
*/

initialize()
{
	// constants for file management
	if (exists("REP")){
		defineConstant("rep", REP);
	} else{
		defineConstant("rep", 1);
	}
	if (exists("ID")){
		defineConstant("id", ID);
	} else{
		defineConstant("id", 1);
	}
	
	
	// parameters specified at command line with defaults
	// scaling factor to speed up simulations
	if (exists("Qfactor")){
		defineConstant("Q", Qfactor);
	} else{
		defineConstant("Q", 1000);
	}
	
	// proportion of mutations which are perfectly correlated
	if (exists("W")){
		defineConstant("w", W);
	} else{
		defineConstant("w", 0.925);
	}
	
	// correlation coefficient for non-perfectly correlated mutations
	if (exists("RHO")){
		defineConstant("rho", RHO);
	} else{
		defineConstant("rho", 0.0);
	}
	
	// set the seed, pulling in the rep and id to differentiate among runs
	if (exists("SEED")){
		setSeed(asInteger(SEED + id * rep));
	} else{
		setSeed(asInteger(42 + id * rep));
	}
	
	
	//demographic parameters (in dadi units)
	defineConstant("Kdip", asInteger(round(161744.0/Q))); // population size of ancestral diploids (p1)
	
	// relative population size of initial tetraploid popuation (p2 and p3)
	if (exists("NU1")){
		defineConstant("nu_auto1", NU1);
	} else{
		defineConstant("nu_auto1", 0.3);
	}
	// relative population size of contemporary tetraploid popuation (p2 and p3)
	if (exists("NU2")){
		defineConstant("nu_auto2", NU2);
	} else{
		defineConstant("nu_auto2", 0.7);
	}
	// diffusion scaled time for initial tetraploid pop 
	if (exists("TET_TIME")){
		defineConstant("tet_T", TET_TIME);
	} else{
		defineConstant("tet_T", 0.3);
	}
	// diffusion scaled migration rate
	if (exists("M_RATE")){
		defineConstant("M", M_RATE);
	} else{
		defineConstant("M", 2.0);
	}
	defineConstant("mig", M/Kdip); // rescaled migration rate
	// relative population size of contemporary diploid population	
	if (exists("NU_DIP")){
		defineConstant("nu_dip", NU_DIP);
	} else{
		defineConstant("nu_dip", 0.8);
	}
	// time ago (in diffusion units) of size change in diploids 
	if (exists("DIP_TIME")){
		defineConstant("T_dip_size_change", DIP_TIME);
	} else{
		defineConstant("T_dip_size_change", 0.15);
	}
	if (exists("BURNIN")){
		defineConstant("burnin", BURNIN);
	} else{
		defineConstant("burnin", 20);
	}
	
	// make sure that the diploid size change occurs more recently than the tetraploid formation
	// this need not be the case, but this is the model I want to consider here 
	// and if the diploid size change were before the tetraploid formation, that would break the script later on
	if(T_dip_size_change > tet_T){
		stop("TET_TIME must be larger than DIP_TIME (i.e., the diploid size change must be more recent than the WGD).");
	}
	// convert above to standard, generational units
	defineConstant("BURN", asInteger(round(burnin*161744.0/Q)));
	
	print(BURN);
	defineConstant("TET_GEN", asInteger(round(2*Kdip*tet_T)));
	
	defineConstant("K_tet_0", asInteger(round(nu_auto1*Kdip))); //initial tetraploid size
	defineConstant("K_tet_F", asInteger(round(nu_auto2*Kdip))); //final tetraploid size
	defineConstant("r", (1/TET_GEN)*log(K_tet_F/K_tet_0)); // exponential growth rate
	
	defineConstant("DIP_GEN", asInteger(round(2*Kdip*T_dip_size_change)));
	defineConstant("K_dip_c", asInteger(round(nu_dip*Kdip))); // K_dip_contemporary
	
	// define the genome length
	if (exists("L")){
		defineConstant("g_size", L - 1);
	} else{
		defineConstant("g_size", 5e3 - 1);
	}
	
	defineConstant("s", -0.0); // deleterious selection coefficient
	
	
	// SRG: Currently, we cannot support selfing and migration simultaneously
	// This is not necessarily difficult to do, but we don't really simulate with selfing for our applications, so we will leave that as a bug for now
	defineConstant("self_rate", 0.0); //selfing rate for inbreeding models
	defineConstant("CHR", 0);
	
	//set as nonWF model
	initializeSLiMModelType("nonWF");
	
	// Use treeseq so we can add neutral mutations later 
	initializeTreeSeq();
	
	//set non-neutral mutation rate
	initializeMutationRate((2.5/3.5)*7e-9*Q);
	
	// m1 mutation type: lognormal DFE, additive dominance and rho!=1
	// we define the alternative effects later (in the nonWF script)
	
	// better fit to discretized bins of the DFE...
	// now, convert to location and shape parameters for the lognormal DFE
	defineConstant("loc", 1.69155136 - log(161744.0/Q));
	defineConstant("shape", 2.37871223);
	
	// set s to 0 for both mutation types since we will calculate fitness separately
	// and sample the selection coefficients from a lognormal dist'n
	initializeMutationType("m1", 0.5, "f", 0.0);
	
	// m2 mutation type: lognormal DFE, additive dominance, and rho=1
	initializeMutationType("m2", 0.5, "f", 0.0);
	
	//ensure both mutation types convert to substitutions
	m1.convertToSubstitution = T;
	m2.convertToSubstitution = T;
	
	// g1 genomic element type: m1 and m2 mutations
	// we will overlay neutral mutations later with msprime
	// the non-perfectly correlated mutations (m1) occur at proportion 1-w with correlation rho and the perfectly correlated ones (m2) occur at proportion w
	initializeGenomicElementType("g1", c(m1, m2), c(1.0 - w, w));
	
	// SRG: Switch the commenting below for a genome with genic and intergenic regions or exons and introns (depending on your interpretation)
	initializeGenomicElement(g1, 0, g_size);
	//defineConstant("L0", 200e3); // between genes
	//defineConstant("L1", 1e3); // gene length
	//for (start in seq(from=L0, to=g_size-(L0+L1), by=(L0+L1)))
	//	initializeGenomicElement(g1, start, (start+L1)-1);
	
	initializeRecombinationRate((1-(1-2*3.676138452842427e-08)^Q)/2);
	
	//define h for polyploids, commented ones include possible examples
	//additive
	defineGlobal("h_m1", c(0.0, 0.25, 0.5, 0.75, 1.0));
	
	//initialize continuous tag for tracking chromosomes to individuals
	defineGlobal("c_tag", 0);
	
	// stop the simulation early if the output file already exists
	if (fileExists("trees/final/auto_final_Q_"+Q+"_REP_"+rep+"_ID_"+id+".trees")){
		stop("File trees/final/auto_final_Q_"+Q+"_REP_"+rep+"_ID_"+id+".trees already exists");
	}
}

// load the burned in population
1 early() {
	if (fileExists("trees/burnin/auto_burnin_Q_"+Q+"_REP_"+rep+"_ID_"+id+".trees")) {
		sim.readFromPopulationFile("trees/burnin/auto_burnin_Q_"+Q+"_REP_"+rep+"_ID_"+id+".trees");
		print("Loaded p1 with " + p1.individualCount + " individuals");
	} else {
		stop("Burnin file not found: trees/burnin/auto_burnin_Q_"+Q+"_REP_"+rep+"_ID_"+id+".trees");
	}
	// reset s and h for mutations
	for (mut in sim.mutations) {
		mut.setValue("s", mut.selectionCoeff);
		mut.setValue("h", h_m1);
	}
	// draw s2 values for the tetraploid for m1 mutations
	for (mut in sim.mutations[sim.mutations.mutationType == m1]){
		if (rho!=1){
			// marginalized bivariate lognormal dist'n	
			sigma = shape * sqrt(1-rho^2);
			mu = (1-rho) * loc + rho*log(-mut.getValue('s'));
			new_s2 = -1*rlnorm(1, mu, sigma);
			// prevent creating a lethal mutation at high frequency in autotetraploids
			new_s2 = max(new_s2, -0.99);
			mut.setValue('s2', new_s2);
		}
		else { // rho = 1 and s2 = s
			mut.setValue('s2', mut.getValue('s'));
		}
	}
	// add subpops for tetraploid
	sim.addSubpop(2, 0); //SRG:tetraploid storage pop
	sim.addSubpop(3, 0); //SRG:tetraploid fitness pop
}

//need to set s and h for the mutations as they appear, since we don't set them initially
mutation(m1)
{
	s_draw = -1*rlnorm(1, loc, shape);
	mut.setValue("s", s_draw);
	mut.setValue("h", h_m1);
	if (rho!=1){
		sigma = shape * sqrt(1-rho^2);
		mu = (1-rho) * loc + rho*log(-s_draw);
		new_s2 = -1*rlnorm(1, mu, sigma);
		// prevent creating a lethal mutation at high frequency in autotetraploids
		new_s2 = max(new_s2, -0.99);
		mut.setValue('s2', new_s2);
	}
	else {
		mut.setValue('s2', s_draw);
	}
	return T;
}

mutation(m2){
	s_draw = -1*rlnorm(1, loc, shape);
	mut.setValue("s", s_draw);
	mut.setValue("h", h_m1);
	return T;
}

//Print tick and fitnesses every one thousand generations
(BURN+1):(BURN+TET_GEN) early() {
	if(community.tick % 1000 == 0){
		print(community.tick);
		print('Diploid average fitness:');
		print(mean(p1.individuals.getValue('fitness')));
		print('Autotetraploid average fitness:');
		print(mean(p3.individuals.getValue('fitness')));
	}
}

// set tag as the index of the individual in the storage population to speed up reproduction and fitness calculations
BURN + 2: first() { // #burn_in + 2
	
	inds = p3.individuals;
	tag = match(inds.tagF, p2.individuals.tagF);
	inds.tag = tag;
}

BURN+1: early(){ // #burn_in + 1
	
	inds = p3.individuals;
	tag = match(inds.tagF, p2.individuals.tagF);
	inds.tag = tag;
}

BURN+1: late() { // #burn_in + 1 
	
	inds = p3.individuals;
	tag = match(inds.tagF, p2.individuals.tagF);
	inds.tag = tag;
}

// fitness calculation and storage for all populations
late(){
	// DIPLOIDS; use 's' for m1 mutations
	for (ind in p1.individuals){
		genomes = c(ind.haplosomes);
		// m1 mutations
		mutations_m1 = unique(c(genomes.mutationsOfType(m1)));
		if(size(mutations_m1)==0){
			fit_vector_m1 = 1.0;
		}
		else {
			counts_m1 = genomes.mutationCountsInHaplosomes(mutations_m1);
			mut = mutations_m1[0];
			count = 2 * counts_m1[0]; //SRG: the 2 scales the diploid counts up to the tetraploid dominance vector of length 5... i.e., if counts_m1 = 1, we want to return h[2] corresponding to dosage = 50%
			if (isNULL(mut.getValue('h')[count]) | isNULL(mut.getValue('s')))
				fit_vector_m1 = 1.0;
			else {
				//calculate fitness for all mutations then take the product of that vector to get multiplicative fitness
				fit_vector_m1 = sapply(seqAlong(mutations_m1), "mut = mutations_m1[applyValue]; count = 2 * counts_m1[applyValue]; 1 + mut.getValue('h')[count] * mut.getValue('s');");
			}
		}
		
		// m2 mutations
		mutations_m2 = unique(c(genomes.mutationsOfType(m2)));
		if(size(mutations_m2)==0){
			fit_vector_m2 = 1.0;
		}
		else{
			counts_m2 = genomes.mutationCountsInHaplosomes(mutations_m2);
			mut = mutations_m2[0];
			count = 2 * counts_m2[0]; //SRG: the 2 scales up to the h-vector of length 5 used for tetraploids
			if (isNULL(mut.getValue('h')[count]) | isNULL(mut.getValue('s'))){
				fit_vector_m2 = 1.0;
			}
			else {
				//calculate fitness for all mutations then take the product of that vector to get multiplicative fitness
				fit_vector_m2 = sapply(seqAlong(mutations_m2), "mut = mutations_m2[applyValue]; count = 2 * counts_m2[applyValue]; 1 + mut.getValue('h')[count] * mut.getValue('s');");
			}
		}
		ind.setValue('fitness', product(fit_vector_m1) * product(fit_vector_m2));
	}
	
	// "non-storage" AUTOTETRAPLOID pop; use 's2' for m1 mutations
	for (ind in p3.individuals){
		genomes = c(ind.genomes,sim.subpopulations[0].individuals[ind.tag].genomes);
		// m1 mutations
		mutations_m1 = unique(c(genomes.mutationsOfType(m1)));
		if(size(mutations_m1)==0){
			fit_vector_m1 = 1.0;
		}
		else {
			counts_m1 = genomes.mutationCountsInGenomes(mutations_m1);
			mut = mutations_m1[0];
			count = counts_m1[0];
			if (isNULL(mut.getValue('h')[count]) | isNULL(mut.getValue('s2')))
				fit_vector_m1 = 1.0;
			else {
				//calculate fitness for all mutations then take the product of that vector to get multiplicative fitness
				fit_vector_m1 = sapply(seqAlong(mutations_m1), "mut = mutations_m1[applyValue]; count = counts_m1[applyValue]; 1 + mut.getValue('h')[count] * mut.getValue('s2');");
			}
		}
		
		// m2 mutations
		mutations_m2 = unique(c(genomes.mutationsOfType(m2)));
		if(size(mutations_m2)==0){
			fit_vector_m2 = 1.0;
		}
		else{
			counts_m2 = genomes.mutationCountsInGenomes(mutations_m2);
			mut = mutations_m2[0];
			count = counts_m2[0];
			if (isNULL(mut.getValue('h')[count]) | isNULL(mut.getValue('s'))){
				fit_vector_m2 = 1.0;
			}
			else {
				//calculate fitness for all mutations then take the product of that vector to get multiplicative fitness
				fit_vector_m2 = sapply(seqAlong(mutations_m2), "mut = mutations_m2[applyValue]; count = counts_m2[applyValue]; 1 + mut.getValue('h')[count] * mut.getValue('s');");
			}
		}
		ind.setValue('fitness', product(fit_vector_m1) * product(fit_vector_m2));
	}
}

// kill all parents in all subpopulations each generation
survival(){
	return(individual.age == 0);
}

// general reproduction rules for diploid population
reproduction(p1) {
	if(community.tick >= BURN + TET_GEN - DIP_GEN){ //final time - time since diploid size change
		inds = p1.individuals;
		fitnesses = pmax(0.0, c(inds.getValue('fitness')));
		parents1 = sample(inds, K_dip_c, replace=T, weights=fitnesses);
		parents2 = sample(inds, K_dip_c, replace=T, weights=fitnesses);
		for (i in seqLen(K_dip_c))
			p1.addCrossed(parents1[i], parents2[i]);
		self.active = 0;
	}
	else if(community.tick > BURN) {
		inds = p1.individuals;
		fitnesses = pmax(0.0, c(inds.getValue('fitness')));
		parents1 = sample(inds, Kdip, replace=T, weights=fitnesses);
		parents2 = sample(inds, Kdip, replace=T, weights=fitnesses);
		for (i in seqLen(Kdip))
			p1.addCrossed(parents1[i], parents2[i]);
		self.active = 0;
	}
}

// general reproduction rules for the tetraploid population
// we need to do this manually to properly recombine and tag chromosomes
reproduction(p3){
	if (community.tick > BURN+1){ // burn_in + 1
		// sample parents for reproduction
		inds = p3.individuals;
		Kauto = asInteger(round(K_tet_0 * exp(r*(community.tick - BURN))));
		fitnesses = pmax(0.0, c(inds.getValue('fitness')));
		
		parents1 = sample(inds, Kauto, replace=T, weights=fitnesses);
		parents2 = sample(inds, Kauto, replace=T, weights=fitnesses);
		
		// sample whether half of the genome is from a migration event (i.e., an unreduced gamete)... note this assumes that an autotetraploid is never formed from two migration events (i.e., we ignore terms of order 1/m^2)
		// 0 = no migration
		// 1 = migration 
		migration = sample(c(0,1), Kauto, T, c(1-mig, mig));
		
		// sample migrants from the diploid population
		dip_migrants = sample(p1.individuals, Kauto, replace=T);
		
		//reproduction for each offspring
		for (j in seqLen(Kauto))
		{
			//selfing = sample(c(0,1), 1, F, c((1-self_rate), self_rate));
			//if(selfing == 1){
			//	parents2[j] = parents1[j] ;
			//}
			
			if (migration[j] == 1){
				if (sample(c(1,2), 1) == 1){ // sample which parent to replace				
					p1_chroms = c(dip_migrants[j].genomes, dip_migrants[j].genomes);
					p2_chroms = c(parents2[j].genomes, p2.individuals[parents2[j].tag].genomes);
				}
				else {
					p1_chroms = c(parents1[j].genomes, p2.individuals[parents1[j].tag].genomes);
					p2_chroms = c(dip_migrants[j].genomes, dip_migrants[j].genomes);
				}
			}
			else {
				// get chromosomes from parent1 and parent2 (including tagged chromosomes in other population)
				p1_chroms = c(parents1[j].genomes, p2.individuals[parents1[j].tag].genomes);
				p2_chroms = c(parents2[j].genomes, p2.individuals[parents2[j].tag].genomes);
			}
			
			//randomize recombination order for autopolyploids
			p1_order = sample(seqLen(4), 4);
			p2_order = sample(seqLen(4), 4);
			
			//draw breakpoints and recombine for first pair
			breakpoints1 = sim.chromosome.drawBreakpoints();
			breakpoints2 = sim.chromosome.drawBreakpoints();
			offspring = p3.addRecombinant(p1_chroms[p1_order[0]], p1_chroms[p1_order[1]], breakpoints1, p2_chroms[p2_order[0]], p2_chroms[p2_order[1]], breakpoints2, randomizeStrands = F);
			
			//draw breakpoints and recombine for second pair
			breakpoints1 = sim.chromosome.drawBreakpoints();
			breakpoints2 = sim.chromosome.drawBreakpoints();
			other = p2.addRecombinant(p1_chroms[p1_order[2]], p1_chroms[p1_order[3]], breakpoints1, p2_chroms[p2_order[2]], p2_chroms[p2_order[3]], breakpoints2, randomizeStrands = F);
			
			//increase tag number and set
			defineGlobal("c_tag", (c_tag+1.0));
			offspring.tagF = c_tag;
			other.tagF = c_tag;
		}
		
		//this is to change reproduction to only once per generation
		self.active = 0;
	}
}


// Reproduction rules for particular tick cycles
reproduction() {
	// create the autotetraploid population from the diploid population
	if (community.tick == BURN + 1) {
		inds = p1.individuals;
		fitnesses = pmax(0.0, c(inds.getValue('fitness')));
		parents1 = sample(inds, K_tet_0, replace=T, weights=fitnesses);
		parents2 = sample(inds, K_tet_0, replace=T, weights=fitnesses);
		
		for (j in seqLen(K_tet_0)){
			p1_chroms = c(parents1[j].genomes, parents1[j].genomes);
			p2_chroms = c(parents2[j].genomes, parents2[j].genomes);
			
			//randomize whether WGD happened before or after meiosis 
			p1_order = sample(seqLen(4), 4);
			p2_order = sample(seqLen(4), 4);
			
			//draw breakpoints and recombine for first pair
			breakpoints1 = sim.chromosome.drawBreakpoints();
			breakpoints2 = sim.chromosome.drawBreakpoints();
			other = p2.addRecombinant(p1_chroms[p1_order[0]], p1_chroms[p1_order[1]], breakpoints1, p2_chroms[p2_order[0]], p2_chroms[p2_order[1]], breakpoints2, randomizeStrands=F);
			
			//draw breakpoints and recombine for second pair
			breakpoints1 = sim.chromosome.drawBreakpoints();
			breakpoints2 = sim.chromosome.drawBreakpoints();
			offspring = p3.addRecombinant(p1_chroms[p1_order[2]], p1_chroms[p1_order[3]], breakpoints1, p2_chroms[p2_order[2]], p2_chroms[p2_order[3]], breakpoints2, randomizeStrands=F);
			
			//increase tag number and set
			defineGlobal("c_tag", (c_tag+1.0));
			offspring.tagF = c_tag;
			other.tagF = c_tag;
		}
		
		//this is to change reproduction to only once per generation
		self.active = 0;
	}
}

//to save time we do this every 100 gens, and check to make sure the tags are accurate using a lookup rather than the sort, do it first/early/late for making sure they're set for every step/calc
//do a quick check to make sure tags are right every 100 gens
BURN + 101: first (){ // #burn-in + auto_begin + 100 + 1
	check_ticks = seq(from=BURN+1,to=BURN+TET_GEN,by=100); // #burn_in + auto_begin + 100 + 1, #End_of_sim + 1
	if(match(community.tick, check_ticks) >= 0){
		for (ind in sim.subpopulations[2].individuals)
			if (ind.tagF != sim.subpopulations[1].individuals[ind.tag].tagF)
				stop("first(): error for individual " + ind.index);
	}
}

//do a quick check to make sure tags are right every 100 gens
BURN + 101: early (){ // #burn-in + auto_begin + 100 + 1
	check_ticks = seq(from=BURN+1,to=BURN+TET_GEN,by=100); // #burn_in + auto_begin + 100 + 1, #End_of_sim + 1
	if(match(community.tick, check_ticks) >= 0){
		for (ind in sim.subpopulations[2].individuals)
			if (ind.tagF != sim.subpopulations[1].individuals[ind.tag].tagF)
				stop("early(): error for individual " + ind.index);
	}
}

//do a quick check to make sure tags are right every 100 gens
BURN + 101: late (){// #burn-in + auto_begin + 100 + 1
	check_ticks = seq(from=BURN+1,to=BURN+TET_GEN,by=100); // #burn_in + auto_begin + 100 + 1, #End_of_sim + 1
	if(match(community.tick, check_ticks) >= 0){
		for (ind in sim.subpopulations[2].individuals)
